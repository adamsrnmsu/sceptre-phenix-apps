# Generated by the sceptre app (metadata.stack: linux_fuxa) for the historian's telegraf.
[agent]
  interval = "5s"
  round_interval = true
  flush_interval = "10s"
  omit_hostname = false

[[inputs.opcua]]
  name = "${measurement}"
  endpoint = "${opc_endpoint}"
  connect_timeout = "10s"
  request_timeout = "5s"
  security_policy = "None"
  security_mode = "None"
  auth_method = "Anonymous"
% for p in points:

  [[inputs.opcua.nodes]]
    name = "${p.device}.${p.field}"
    namespace = "${ns}"
    identifier_type = "s"
    identifier = "${p.node}"
    default_tags = { rtu = "${p.rtu}", device = "${p.device}", field = "${p.field}" }
% endfor


[[outputs.influxdb_v2]]
  urls = ["http://127.0.0.1:8086"]
  token = "${influx_token}"
  organization = "${influx_org}"
  bucket = "${influx_bucket}"